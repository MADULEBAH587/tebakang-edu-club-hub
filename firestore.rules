rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "REPLACE_WITH_ADMIN_UID";
    }

    // Club Hub is public-facing.
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
